# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — never commit real keys.
#
# This project points at a SELF-HOSTED Supabase instance (not supabase.com).
# Both values come from the server's own `.env` file, next to its
# docker-compose.yml — not from the Supabase dashboard.
#
# Only VITE_-prefixed vars are exposed to the browser bundle. That is why the
# anon key belongs here and the service_role key NEVER does — anything in this
# file ships to every visitor. Row Level Security is what keeps the anon key
# safe to publish.

# Base URL of the Kong API gateway — NO trailing slash.
# On a self-hosted box this is the host:port that fronts /auth, /rest and
# /storage. It is often the same URL you use for Studio.
# e.g. http://62.171.171.71:8010
VITE_SUPABASE_URL=

# Public anon key — the server's ANON_KEY (a "eyJ..." JWT with "role":"anon").
# Must be the exact key baked into the server's Kong config, or the gateway
# rejects every request with 401 "No API key found in request".
VITE_SUPABASE_ANON_KEY=

# Postgres connection, used ONLY by `pnpm gen:types` on the command line.
# Not VITE_-prefixed, so it never reaches the browser. Keep it out of git.
#
# Port 5432 on this VM is the Supavisor POOLER, not raw Postgres, so:
#   * the username must be  postgres.<POOLER_TENANT_ID>  -- not just "postgres"
#   * special chars in the password must be URL-encoded (@ -> %40, = -> %3D)
# The tenant id on this box is the stock default "your-tenant-id". The password
# is POSTGRES_PASSWORD from the VM's supabase .env -- NOT the Studio password.
#   e.g. postgresql://postgres.your-tenant-id:<url-encoded-password>@62.171.171.71:5432/postgres
SUPABASE_DB_URL=
