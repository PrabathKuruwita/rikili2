# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — never commit real keys.
#
# Both values come from your Supabase project:
#   Supabase Dashboard -> Project Settings -> API
#
# Only VITE_-prefixed vars are exposed to the browser bundle. That is why the
# anon key belongs here and the service_role key NEVER does — anything in this
# file ships to every visitor. Row Level Security is what keeps the anon key
# safe to publish.

# Project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Public anon / publishable key (starts with "eyJ..." or "sb_publishable_...")
VITE_SUPABASE_ANON_KEY=
